#!/usr/bin/env bash
# ic-link: create (or repair) every symlink the agent toolchain depends on.
#
# Idempotent: safe to run any time; ln -sfn replaces stale links in place.
# This is the versioned recipe for the wiring that ic-doctor verifies:
#   - agent skills into ~/.agents/skills, mirrored to ~/.claude/skills,
#     ~/.codex/skills, and ~/.grok/skills (when Grok is installed); every
#     directory under files/skills is one of them, found by setup/lib/skills.sh
#   - the cross-tool instruction chain (~/AGENTS.md, ~/.codex/AGENTS.md),
#     plus each tool's own manual for Grok and Gemini
#   - Grok's own AGENTS.md and agent definitions (never Claude's)
#   - the personal layer from the private ~/github/agents repo, if present,
#     including Claude subagents (~/.claude/agents) and rules (~/.claude/rules)
set -euo pipefail

GH_ROOT="$HOME/github"
SELF_REPO=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && cd ../.. && pwd)

# Platform detection is shared with the installer, the updater, and the health
# check so the four cannot disagree about which entry module is in force.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../setup/lib/platform.sh
. "$SELF_REPO/setup/lib/platform.sh"
# shellcheck source=../../setup/lib/skills.sh
. "$SELF_REPO/setup/lib/skills.sh"

# The links below are durable state in $HOME and are read long after ic-link
# exits, so they point at the checkout the entry module declares as dotfilesDir,
# not at whatever tree ic-link happened to be invoked from. Running ic-link
# from a git worktree therefore still writes links that survive the worktree.
# Each platform activates its own entry module with its own literal, so read the
# one actually in force here, exactly as ic-doctor does.
# Falls back to the invoking checkout when the literal cannot be parsed, and
# says so when the entry module could not be read at all, so the fallback is
# never silent.
case "$(ic_detect_target)" in
  darwin) ENTRY_MODULE="$SELF_REPO/nix/user.nix" ;;
  linux)  ENTRY_MODULE="$SELF_REPO/nix/linux-user.nix" ;;
  wsl)    ENTRY_MODULE="$SELF_REPO/nix/wsl-user.nix" ;;
  *)      ENTRY_MODULE="" ;;
esac
declared_rel=""
if [ -n "$ENTRY_MODULE" ]; then
  declared_status=0
  declared_rel=$(ic_declared_dotfiles_rel "$ENTRY_MODULE") || declared_status=$?
  if [ "$declared_status" -eq 2 ]; then
    echo "ic-link: warning: could not read $ENTRY_MODULE; linking against the invoking checkout $SELF_REPO instead" >&2
  fi
fi
if [ -n "$declared_rel" ]; then
  DOTFILES="$HOME$declared_rel"
else
  DOTFILES="$SELF_REPO"
fi
if [ ! -d "$DOTFILES" ]; then
  echo "ic-link: warning: declared dotfilesDir $DOTFILES does not exist; the links to this repo's own skills will dangle until the repo is cloned there" >&2
fi

# Skills whose directory name matches their repo name.
REGULAR_SKILLS="chrome-devtools-axi gh-axi gnhf no-mistakes quota-axi tasks-axi"
# Skills this repo owns: every files/skills/<name>/SKILL.md in this checkout.
OWNED_SKILLS=$(ic_owned_skills "$SELF_REPO" | tr '\n' ' ')
# All skills, for mirroring into per-tool skill directories.
ALL_SKILLS="axi chrome-devtools-axi gh-axi gnhf lavish no-mistakes quota-axi stow tasks-axi $OWNED_SKILLS"

# ln -sfn replaces a symlink in place, but pointed at a real directory it would
# create the link inside that directory instead. Skill directories can hold real
# directories written by other installers (npx skills), so refuse those loudly
# rather than scribbling into them.
link_skill() { # <target> <link>
  if [ -d "$2" ] && [ ! -L "$2" ]; then
    echo "ic-link: warning: $2 is a real directory, not a link; left untouched (move it aside, then rerun ic-link)" >&2
    return 0
  fi
  ln -sfn "$1" "$2"
}

mkdir -p "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.codex/skills"

# 1. Canonical skill links: ~/.agents/skills/<name> -> source in a clone.
for s in $REGULAR_SKILLS; do
  link_skill "$GH_ROOT/$s/skills/$s" "$HOME/.agents/skills/$s"
done
link_skill "$GH_ROOT/lavish-axi/skills/lavish"  "$HOME/.agents/skills/lavish"
link_skill "$GH_ROOT/firstmate/skills/stow"     "$HOME/.agents/skills/stow"
link_skill "$GH_ROOT/axi/.agents/skills/axi"    "$HOME/.agents/skills/axi"
for s in $OWNED_SKILLS; do
  link_skill "$DOTFILES/files/skills/$s" "$HOME/.agents/skills/$s"
done

# 2. Mirrors: every consumer sees the same canonical set.
for s in $ALL_SKILLS; do
  link_skill "../../.agents/skills/$s" "$HOME/.claude/skills/$s"
  link_skill "../../.agents/skills/$s" "$HOME/.codex/skills/$s"
done

# 3. Cross-tool instruction chain.
# ~/AGENTS.md is what Codex and every other AGENTS.md reader resolves to, so it
# gets the tool-neutral manual (shared rules plus routing, no tool tuning) rather
# than Claude's. Pointing it at Claude's file makes one tool's manual another
# tool's manual, which the shared rules themselves forbid. Without the private
# repo there is no neutral manual to point at, so the old target stands.
AGENTS_REPO="$GH_ROOT/agents"
if [ -f "$AGENTS_REPO/AGENTS.md" ]; then
  ln -sfn "$AGENTS_REPO/AGENTS.md" "$HOME/AGENTS.md"
elif [ -d "$AGENTS_REPO" ]; then
  echo "ic-link: warning: $AGENTS_REPO/AGENTS.md missing; not pointing ~/AGENTS.md at another tool's manual (run: $AGENTS_REPO/bin/build-manuals)" >&2
else
  ln -sfn ".claude/CLAUDE.md" "$HOME/AGENTS.md"
fi
ln -sfn "$HOME/AGENTS.md"   "$HOME/.codex/AGENTS.md"

# 4. Personal layer from the private agents repo (skipped if not cloned).
if [ -d "$AGENTS_REPO" ]; then
  ln -sf "$AGENTS_REPO/CLAUDE.md"            "$HOME/.claude/CLAUDE.md"
  ln -sf "$AGENTS_REPO/OPINIONS.md"          "$HOME/OPINIONS.md"
  ln -sf "$AGENTS_REPO/VOICE.md"             "$HOME/VOICE.md"
  ln -sf "$AGENTS_REPO/claude/settings.json" "$HOME/.claude/settings.json"
  # Claude subagents and user-level rules, one link per file, so anything Claude
  # itself writes into these directories (/agents creates files there) is kept.
  for kind in agents rules; do
    [ -d "$AGENTS_REPO/claude/$kind" ] || continue
    mkdir -p "$HOME/.claude/$kind"
    for f in "$AGENTS_REPO/claude/$kind"/*.md; do
      [ -f "$f" ] || continue
      dest="$HOME/.claude/$kind/$(basename "$f")"
      if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        echo "ic-link: warning: $dest is a real file, not a link; left untouched (merge it into $f, remove it, then rerun ic-link)" >&2
        continue
      fi
      ln -sf "$f" "$dest"
    done
  done
  personal_layer=1
else
  personal_layer=0
fi

# 5. Grok Build: separate agent files, never Claude's AGENTS.md.
# The Grok installer owns ~/.grok; never create that directory.
# Firstmate owns ~/.grok/hooks; never create, replace, or empty it.
# Grok owns and rewrites ~/.grok/config.toml; never link, replace, or delete it.
if [ -d "$HOME/.grok" ]; then
  mkdir -p "$HOME/.grok/skills" "$HOME/.grok/agents"
  for s in $ALL_SKILLS; do
    link_skill "../../.agents/skills/$s" "$HOME/.grok/skills/$s"
  done
  if [ "$personal_layer" -eq 1 ]; then
    if [ -f "$AGENTS_REPO/GROK.md" ]; then
      ln -sf "$AGENTS_REPO/GROK.md" "$HOME/.grok/AGENTS.md"
    else
      echo "ic-link: warning: $AGENTS_REPO/GROK.md missing; not pointing ~/.grok/AGENTS.md at Claude's file" >&2
    fi
    if [ -d "$AGENTS_REPO/grok/agents" ]; then
      for f in "$AGENTS_REPO"/grok/agents/*.md; do
        [ -f "$f" ] || continue
        ln -sf "$f" "$HOME/.grok/agents/$(basename "$f")"
      done
    fi
  fi
fi

# 6. Gemini: its own manual, never Claude's and never its memory file.
# The Gemini installer owns ~/.gemini; never create that directory.
# ~/.gemini/GEMINI.md is Gemini's own memory file, written by /memory add;
# never link, replace, or delete it. The manual goes to a separate filename,
# which Gemini loads only when context.fileName lists it - ic-doctor checks that
# setting, because settings.json is Gemini's file to own rather than ours.
if [ -d "$HOME/.gemini" ] && [ "$personal_layer" -eq 1 ]; then
  if [ -f "$AGENTS_REPO/GEMINI.md" ]; then
    ln -sf "$AGENTS_REPO/GEMINI.md" "$HOME/.gemini/AGENTS.md"
  else
    echo "ic-link: warning: $AGENTS_REPO/GEMINI.md missing; not pointing ~/.gemini/AGENTS.md at another tool's manual" >&2
  fi
fi

if [ "$personal_layer" -eq 1 ]; then
  echo "ic-link: linked skills, cross-tool chain, and personal layer"
else
  echo "ic-link: linked skills and cross-tool chain (no $AGENTS_REPO; personal layer skipped)"
fi
echo "ic-link: run ic-doctor to verify"
