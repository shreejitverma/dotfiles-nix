#!/usr/bin/env bash
# ic-doctor: one-shot health check for the agent-first IC toolchain.
#
# Verifies the integration layers documented in the README:
#   1. this repo's checkout path vs the dotfilesDir this platform's entry module declares
#   2. forks under ~/github (clone, upstream remote, branch, cleanliness)
#   3. binaries on PATH with working --version
#   4. agent skill symlinks (~/.agents/skills and ~/.claude/skills)
#   5. the daily sync-forks schedule (launchd agent on macOS, systemd user
#      timer on Linux) and the newest fleet sync log
#   6. auth (gh, quota-axi keychain access)
#   7. cross-tool defaults (~/AGENTS.md chain, codex AGENTS.md and skills,
#      grok AGENTS.md / agent definitions / skills / binary,
#      gemini AGENTS.md and its context.fileName setting)
#
# Read-only: it never mutates anything. Exits non-zero if any check FAILs;
# warns are informational and do not affect the exit code.
#
# Messages print a literal ~ for readability; none of them is ever used as a path.
# shellcheck disable=SC2088
set -uo pipefail

# Platform differences (PATH, platform detection, the literal parsers) live in
# one place, shared with the installer and sync-forks. Derived from this
# script's own location, so ic-doctor reports on the checkout it was invoked
# from.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../setup/lib/platform.sh
. "$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && cd ../.. && pwd)/setup/lib/platform.sh"

PATH="$(ic_default_path)"
export PATH

GH_ROOT="$HOME/github"
FLEET_DIR="$GH_ROOT/.fleet"
MANIFEST="$FLEET_DIR/manifest.yaml"
FORKS="no-mistakes treehouse firstmate gnhf lavish-axi axi chrome-devtools-axi gh-axi tasks-axi wheelhouse quota-axi"
BINARIES="no-mistakes treehouse gnhf lavish-axi chrome-devtools-axi gh-axi tasks-axi quota-axi"
SKILLS="axi chrome-devtools-axi gh-axi gnhf lavish no-mistakes quota-axi ship stow tasks-axi"

fail=0
ok()   { printf '  ok    %s\n' "$*"; }
warn() { printf '  warn  %s\n' "$*"; }
bad()  { printf '  FAIL  %s\n' "$*"; fail=1; }

# Everything this repo wires into the machine (PATH, the zsh workflow layer,
# the out-of-store app config symlinks, the sync-forks scheduler entry) is built
# from the dotfilesDir literal in the entry module. If the checkout is not
# actually at that path, all of it dangles silently, so check it first.
echo "[1/7] dotfiles checkout"
SELF_REPO=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && cd ../.. && pwd)
TARGET=$(ic_detect_target)
# Each platform activates its own entry module, and each declares its own
# dotfilesDir literal. Read the one that is actually in force here, the way
# setup/linux.sh reads the module backing the profile it is about to activate.
case "$TARGET" in
  darwin) ENTRY_MODULE="$SELF_REPO/nix/user.nix" ;;
  linux)  ENTRY_MODULE="$SELF_REPO/nix/linux-user.nix" ;;
  wsl)    ENTRY_MODULE="$SELF_REPO/nix/wsl-user.nix" ;;
  *)      ENTRY_MODULE="" ;;
esac
if [ -z "$ENTRY_MODULE" ]; then
  bad "unsupported platform '$TARGET': no entry module to check the checkout against"
else
  entry_name="nix/$(basename "$ENTRY_MODULE")"
  declared_status=0
  declared_rel=$(ic_declared_dotfiles_rel "$ENTRY_MODULE") || declared_status=$?
  if [ "$declared_status" -eq 2 ]; then
    bad "could not read $ENTRY_MODULE at all"
  elif [ -z "$declared_rel" ]; then
    bad "could not read dotfilesDir from $ENTRY_MODULE"
  else
    declared="$HOME$declared_rel"
    if [ ! -d "$declared" ]; then
      bad "$entry_name declares dotfilesDir=$declared, which does not exist (checkout is $SELF_REPO)"
    elif [ "$(cd -P "$declared" && pwd)" != "$SELF_REPO" ]; then
      bad "dotfilesDir=$declared does not match this checkout $SELF_REPO (rebuild would link the wrong tree)"
    else
      ok "dotfilesDir matches this checkout ($SELF_REPO)"
    fi
  fi
fi
# The rebuild links these through mkOutOfStoreSymlink, so a wrong dotfilesDir
# leaves them present but dangling; -e follows the chain and catches that.
# WSL does not compose nix/home/desktop.nix, which is where those links are
# declared, because a WSL distro has no display server. Their absence there is
# the intended outcome, not a fault.
if [ "$TARGET" = wsl ]; then
  ok "desktop app configs not linked (no desktop layer on WSL)"
else
  for f in .config/wezterm/wezterm.lua .config/herdr/config.toml; do
    if [ -e "$HOME/$f" ]; then ok "~/$f resolves"; else bad "~/$f dangling or missing (run: rebuild)"; fi
  done
fi
if [ -f "$SELF_REPO/files/zsh/ic-workflow.zsh" ] && \
   grep -qF "$SELF_REPO/files/zsh/ic-workflow.zsh" "$HOME/.zshrc" 2>/dev/null; then
  ok "zsh sources the IC workflow layer"
else
  bad "~/.zshrc does not source $SELF_REPO/files/zsh/ic-workflow.zsh (run: rebuild)"
fi

echo "[2/7] forks under $GH_ROOT"
# The branch a fork is expected to sit on comes from the fleet manifest's
# default_branch, the same field sync-forks reads. Falls back to main when the
# manifest is absent or has no entry for the repo (matching sync-forks'
# parser default).
fork_default_branch() { # repo
  local b=""
  if [ -f "$MANIFEST" ]; then
    b=$(awk -v want="$1" '
      /^- name:/           { if (name == want) exit; name = $3; branch = "main" }
      /^  default_branch:/ { branch = $2 }
      END                  { if (name == want) print branch }
    ' "$MANIFEST" 2>/dev/null)
  fi
  printf '%s\n' "${b:-main}"
}
for r in $FORKS; do
  d="$GH_ROOT/$r"
  if [ ! -d "$d/.git" ]; then bad "$r: clone missing"; continue; fi
  if ! git -C "$d" remote get-url upstream >/dev/null 2>&1; then
    bad "$r: no upstream remote"; continue
  fi
  branch=$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)
  expected=$(fork_default_branch "$r")
  if [ -n "$(git -C "$d" status --porcelain 2>/dev/null | head -1)" ]; then
    warn "$r: uncommitted changes (sync-forks will skip it)"
  elif [ "$branch" != "$expected" ]; then
    warn "$r: on branch $branch, not $expected (sync-forks will skip it)"
  else
    ok "$r"
  fi
done

echo "[3/7] binaries"
for t in $BINARIES; do
  if p=$(command -v "$t" 2>/dev/null); then
    if v=$("$t" --version 2>/dev/null | head -1); then
      ok "$t $v"
    else
      bad "$t: on PATH at $p but --version failed (broken link? rebuild the clone)"
    fi
  else
    bad "$t: not on PATH"
  fi
done

echo "[4/7] agent skills"
for s in $SKILLS; do
  missing=""
  for base in "$HOME/.agents/skills" "$HOME/.claude/skills"; do
    [ -f "$base/$s/SKILL.md" ] || missing="$missing $base/$s"
  done
  if [ -n "$missing" ]; then bad "$s: missing or broken symlink:$missing"; else ok "$s"; fi
done

echo "[5/7] daily sync"
# macOS schedules this with a launchd agent; Linux with a systemd user timer.
# Both run daily at 10:00 and catch up on runs missed while the machine was
# off (RunAtLoad / Persistent). WSL deliberately ships the timer disabled,
# because systemd is off by default there, so a missing timer is reported as
# a warning rather than a failure.
case "$TARGET" in
  darwin)
    if launchctl list 2>/dev/null | grep -q "sync-forks"; then
      ok "launchd agent loaded (daily 10:00)"
    else
      bad "launchd agent not loaded (run: rebuild)"
    fi
    ;;
  wsl)
    if systemctl --user is-enabled sync-forks.timer >/dev/null 2>&1; then
      ok "systemd user timer enabled (daily 10:00)"
    else
      warn "systemd timer not enabled (expected on WSL; run 'syncforks' by hand)"
    fi
    ;;
  *)
    if systemctl --user is-enabled sync-forks.timer >/dev/null 2>&1; then
      ok "systemd user timer enabled (daily 10:00)"
    else
      bad "systemd user timer not enabled (run: rebuild)"
    fi
    ;;
esac
# sync-forks writes dated logs to ~/github/.fleet/logs (30-day rotation). The
# .fleet directory is bootstrapped outside this repo, so its absence means the
# fleet is simply not set up on this host: a warn, not a failure.
if [ -d "$FLEET_DIR" ]; then
  latest=$(find "$FLEET_DIR/logs" -name 'sync-*.log' 2>/dev/null | sort | tail -1)
  if [ -n "$latest" ]; then
    ok "last log ($(basename "$latest")): $(tail -1 "$latest")"
  else
    warn "no sync log yet in $FLEET_DIR/logs (runs daily at 10:00, or run: syncforks)"
  fi
else
  warn "fleet not set up ($FLEET_DIR absent); sync-forks exits with nothing to sync"
fi

echo "[6/7] auth"
if gh auth status >/dev/null 2>&1; then
  ok "gh authenticated"
else
  bad "gh not authenticated (run: gh auth login)"
fi
if command -v quota-axi >/dev/null 2>&1; then
  if quota-axi --provider claude 2>/dev/null | grep -q ",fresh,"; then
    ok "quota-axi reads live claude quota"
  else
    warn "quota-axi cannot read claude quota (run: quota-axi --allow-keychain-prompt auth)"
  fi
fi

echo "[7/7] cross-tool defaults"
# ~/AGENTS.md is what Codex and every other AGENTS.md reader resolves to. It must
# carry the tool-neutral manual when one exists, never Claude's: one tool reading
# another tool's manual is the exact fault the per-tool build exists to remove.
agents_md_target="$(readlink "$HOME/AGENTS.md" 2>/dev/null || true)"
if [ ! -f "$HOME/AGENTS.md" ]; then
  if [ -f "$GH_ROOT/agents/AGENTS.md" ]; then
    agents_md_fix="run: ic-link"
  elif [ -d "$GH_ROOT/agents" ]; then
    agents_md_fix="run: ~/github/agents/bin/build-manuals, then ic-link"
  else
    agents_md_fix="clone ~/github/agents, then run: ic-link"
  fi
  bad "~/AGENTS.md is missing or dangles, so Codex reads nothing ($agents_md_fix)"
elif [ -f "$GH_ROOT/agents/AGENTS.md" ]; then
  if [ "$agents_md_target" = "$GH_ROOT/agents/AGENTS.md" ]; then
    ok "~/AGENTS.md -> agents/AGENTS.md (tool-neutral)"
  elif [ "$agents_md_target" = ".claude/CLAUDE.md" ]; then
    bad "~/AGENTS.md still resolves to Claude's manual, so Codex reads Claude-only rules (run: ic-link)"
  else
    bad "~/AGENTS.md is not a symlink to $GH_ROOT/agents/AGENTS.md (run: ic-link)"
  fi
  if grep -q "Default development system" "$GH_ROOT/agents/AGENTS.md" 2>/dev/null; then
    ok "agents/AGENTS.md declares the default development system"
  else
    bad "agents/AGENTS.md missing the 'Default development system' section"
  fi
elif [ -d "$GH_ROOT/agents" ]; then
  bad "~/github/agents/AGENTS.md not generated, so ~/AGENTS.md carries another tool's manual (run: ~/github/agents/bin/build-manuals, then ic-link)"
elif [ "$agents_md_target" = ".claude/CLAUDE.md" ]; then
  ok "~/AGENTS.md -> ~/.claude/CLAUDE.md (no agents repo; neutral manual unavailable)"
else
  bad "~/AGENTS.md is not a symlink to .claude/CLAUDE.md"
fi
if grep -q "Default development system" "$HOME/.claude/CLAUDE.md" 2>/dev/null; then
  ok "CLAUDE.md declares the default development system"
else
  bad "CLAUDE.md missing the 'Default development system' section"
fi
if [ -d "$HOME/.codex" ]; then
  if [ -f "$HOME/.codex/AGENTS.md" ]; then
    ok "codex: ~/.codex/AGENTS.md resolves"
  else
    bad "codex: ~/.codex/AGENTS.md missing or broken (ln -sfn ~/AGENTS.md ~/.codex/AGENTS.md)"
  fi
  codex_missing=""
  for s in $SKILLS; do
    [ -f "$HOME/.codex/skills/$s/SKILL.md" ] || codex_missing="$codex_missing $s"
  done
  if [ -n "$codex_missing" ]; then
    bad "codex: skills missing or broken:$codex_missing"
  else
    ok "codex: all skills linked"
  fi
else
  warn "codex not set up (~/.codex absent); skipping"
fi
if [ -d "$HOME/.grok" ]; then
  if p=$(command -v grok 2>/dev/null); then
    if [ "$p" != "$HOME/.local/bin/grok" ]; then
      bad "grok on PATH is $p, want ~/.local/bin/grok (official installer; npm uninstall -g @xai-official/grok)"
    elif v=$(grok --version 2>/dev/null | head -1); then
      ok "grok $v"
    else
      bad "grok: on PATH at $p but --version failed"
    fi
    dups=$(type -a grok 2>/dev/null | grep -c "is /" || true)
    if [ "$dups" -gt 1 ]; then
      bad "grok: $dups copies on PATH: $(type -a grok | awk '/is \// {print $NF}' | tr '\n' ' ')(keep ~/.local/bin/grok; npm uninstall -g @xai-official/grok)"
    fi
  else
    bad "grok: ~/.grok exists but grok is not on PATH"
  fi
  grok_missing=""
  for s in $SKILLS; do
    [ -f "$HOME/.grok/skills/$s/SKILL.md" ] || grok_missing="$grok_missing $s"
  done
  if [ -n "$grok_missing" ]; then
    bad "grok: skills missing or broken:$grok_missing (run: ic-link)"
  else
    ok "grok: all skills linked"
  fi
  if [ -f "$GH_ROOT/agents/GROK.md" ]; then
    grok_manual_fix="run: ic-link"
  else
    grok_manual_fix="add ~/github/agents/GROK.md, then run: ic-link"
  fi
  grok_manual=$(readlink "$HOME/.grok/AGENTS.md" 2>/dev/null)
  if [ -n "$grok_manual" ] && [ "$grok_manual" != "$GH_ROOT/agents/GROK.md" ]; then
    bad "grok: ~/.grok/AGENTS.md points at $grok_manual, not ~/github/agents/GROK.md ($grok_manual_fix)"
  fi
  if [ -d "$GH_ROOT/agents" ]; then
    if [ "$grok_manual" = "$GH_ROOT/agents/GROK.md" ]; then
      ok "grok: ~/.grok/AGENTS.md -> ~/github/agents/GROK.md"
    elif [ -z "$grok_manual" ]; then
      bad "grok: ~/.grok/AGENTS.md is missing or not a symlink to ~/github/agents/GROK.md ($grok_manual_fix)"
    fi
    if [ ! -f "$GH_ROOT/agents/GROK.md" ]; then
      bad "grok: ~/github/agents/GROK.md missing (add it to the agents repo, then run: ic-link)"
    elif grep -q "Default development system" "$GH_ROOT/agents/GROK.md" 2>/dev/null; then
      ok "GROK.md declares the default development system"
    else
      bad "GROK.md missing the 'Default development system' section"
    fi
    grok_agents_n=0
    grok_agents_bad=""
    for f in "$GH_ROOT"/agents/grok/agents/*.md; do
      [ -f "$f" ] || continue
      grok_agents_n=$((grok_agents_n + 1))
      a=$(basename "$f")
      [ "$(readlink "$HOME/.grok/agents/$a" 2>/dev/null)" = "$f" ] || grok_agents_bad="$grok_agents_bad $a"
    done
    if [ "$grok_agents_n" -eq 0 ]; then
      warn "grok: no agent definitions at ~/github/agents/grok/agents/*.md; none to link"
    elif [ -n "$grok_agents_bad" ]; then
      bad "grok: agent definitions not linked:$grok_agents_bad (run: ic-link)"
    else
      ok "grok: $grok_agents_n agent definitions linked from ~/github/agents/grok/agents"
    fi
    grok_agents_stale=""
    for f in "$HOME"/.grok/agents/*; do
      [ -L "$f" ] && [ ! -e "$f" ] || continue
      case "$(readlink "$f")" in
        "$GH_ROOT"/agents/grok/agents/*) grok_agents_stale="$grok_agents_stale $(basename "$f")" ;;
      esac
    done
    if [ -n "$grok_agents_stale" ]; then
      bad "grok: dangling agent links, source gone from ~/github/agents/grok/agents:$grok_agents_stale (remove: cd ~/.grok/agents && rm$grok_agents_stale)"
    fi
  else
    warn "grok: private agents repo not cloned (~/github/agents); AGENTS.md and agent definitions not checked"
  fi
else
  warn "grok not set up (~/.grok absent); skipping"
fi
if [ -d "$HOME/.gemini" ]; then
  if [ -L "$HOME/.gemini/GEMINI.md" ]; then
    bad "gemini: ~/.gemini/GEMINI.md is a symlink; it is Gemini's own memory file and must stay a real file"
  fi
  if [ -f "$GH_ROOT/agents/GEMINI.md" ]; then
    gemini_manual_fix="run: ic-link"
  else
    gemini_manual_fix="add ~/github/agents/GEMINI.md, then run: ic-link"
  fi
  gemini_manual=$(readlink "$HOME/.gemini/AGENTS.md" 2>/dev/null)
  if [ -n "$gemini_manual" ] && [ "$gemini_manual" != "$GH_ROOT/agents/GEMINI.md" ]; then
    bad "gemini: ~/.gemini/AGENTS.md points at $gemini_manual, not ~/github/agents/GEMINI.md ($gemini_manual_fix)"
  fi
  if [ ! -d "$GH_ROOT/agents" ]; then
    if [ -z "$gemini_manual" ]; then
      warn "gemini: private agents repo not cloned; manual not linked"
    fi
  elif [ ! -f "$GH_ROOT/agents/GEMINI.md" ]; then
    bad "gemini: $GH_ROOT/agents/GEMINI.md missing, so there is no manual to link"
  elif [ "$gemini_manual" = "$GH_ROOT/agents/GEMINI.md" ]; then
    ok "gemini: ~/.gemini/AGENTS.md -> agents/GEMINI.md"
    # The link alone does nothing: Gemini reads only the filenames listed here.
    if grep -q '"AGENTS.md"' "$HOME/.gemini/settings.json" 2>/dev/null; then
      ok "gemini: context.fileName lists AGENTS.md"
    else
      bad "gemini: ~/.gemini/settings.json context.fileName does not list AGENTS.md, so the linked manual is never loaded"
    fi
    if grep -q "Default development system" "$GH_ROOT/agents/GEMINI.md" 2>/dev/null; then
      ok "GEMINI.md declares the default development system"
    else
      bad "GEMINI.md missing the 'Default development system' section"
    fi
  elif [ -z "$gemini_manual" ]; then
    bad "gemini: ~/.gemini/AGENTS.md is missing or not a symlink to ~/github/agents/GEMINI.md ($gemini_manual_fix)"
  fi
else
  warn "gemini not set up (~/.gemini absent); skipping"
fi
if [ -d "$GH_ROOT/agents" ]; then
  agents_bad=""
  for f in "$HOME/.claude/CLAUDE.md" "$HOME/OPINIONS.md" "$HOME/VOICE.md" "$HOME/.claude/settings.json"; do
    case "$(readlink "$f" 2>/dev/null)" in
      "$GH_ROOT"/agents/*) ;;
      *) agents_bad="$agents_bad $f" ;;
    esac
  done
  if [ -n "$agents_bad" ]; then
    bad "personal layer not linked into ~/github/agents:$agents_bad (run: ic-link)"
  else
    ok "personal layer versioned in ~/github/agents"
  fi
  if [ -n "$(git -C "$GH_ROOT/agents" status --porcelain 2>/dev/null | head -1)" ]; then
    warn "agents repo has uncommitted changes (commit and push to keep it versioned)"
  fi
else
  warn "private agents repo not cloned (~/github/agents); personal layer unversioned"
fi

echo
if [ "$fail" -eq 0 ]; then
  echo "ic-doctor: all checks passed"
else
  echo "ic-doctor: issues found, see FAIL lines above"
fi
exit "$fail"
