#!/usr/bin/env bash
# sync-forks: daily sync of forked repos with their upstream parents.
#
# The repo list lives in the fleet manifest (~/github/.fleet/manifest.yaml);
# this script never hardcodes repo names. For each entry with sync: true it:
#   1. re-asserts commit identity (strips any local user.email/user.name
#      override; a wrong resolved identity fails the repo),
#   2. fetches all remotes and computes divergence against upstream (a fork
#      whose branch has local commits is reported as DIVERGED and left
#      untouched - never merged, never rebased, and its GitHub remote is
#      never moved either),
#   3. only when the fork has no local-only commits, asks GitHub to
#      fast-forward the fork's default branch from upstream (gh repo sync -b:
#      server-side, cheap, refuses non-fast-forwards),
#   4. fast-forwards the local default branch from upstream (--ff-only),
#   5. pushes the updated default branch to the fork (normal push only),
#   6. re-runs the repo's install command from the manifest when it updated,
#      so npm-linked CLIs and ~/.local/bin binaries stay current.
#
# Safe by design: skips dirty trees and in-progress rebases/merges, skips
# repos not on their default branch, is non-fatal per repo, never force-pushes,
# and notifies only on failure. Run with --dry-run to only report drift.
set -uo pipefail

# Platform differences (PATH, log location, notifications) live in one place,
# shared with the installer and ic-doctor. Derived from this script's own
# location so it resolves under launchd and systemd alike.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../../setup/lib/platform.sh
. "$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && cd ../.. && pwd)/setup/lib/platform.sh"

# Tools must be found under launchd's and systemd's minimal environment.
PATH="$(ic_default_path)"
export PATH

GH_ROOT="$HOME/github"
FLEET_DIR="$GH_ROOT/.fleet"
MANIFEST="$FLEET_DIR/manifest.yaml"
LOG_DIR="$FLEET_DIR/logs"
LOG="$LOG_DIR/sync-$(date +%Y%m%d).log"
IDENT_EMAIL="shreejitverma@gmail.com"
IDENT_NAME="Shreejit Verma"

mkdir -p "$LOG_DIR"
# Rotate: keep 30 days of daily logs.
find "$LOG_DIR" -name 'sync-*.log' -mtime +30 -delete 2>/dev/null || true

DRY=0
[ "${1:-}" = "--dry-run" ] && DRY=1

log()    { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$LOG"; }
notify() { ic_notify "$1" "$2"; }

if [ ! -f "$MANIFEST" ]; then
  log "no fleet manifest at $MANIFEST -> nothing to sync on this host"
  exit 0
fi

# Parse the manifest into "name|default_branch|install" lines for sync: true
# entries. The manifest format is controlled by us (flat two-space keys under
# "- name:" items), so a line-oriented awk pass is deliberate - no yq
# dependency under launchd's minimal PATH.
manifest_entries() {
  awk '
    function flush() {
      if (name != "" && sync == "true") printf "%s|%s|%s\n", name, branch, install
      name = ""; branch = "main"; sync = "false"; install = "none"
    }
    /^- name:/        { flush(); name = $3 }
    /^  default_branch:/ { branch = $2 }
    /^  sync:/        { sync = $2 }
    /^  install:/     {
      install = $0
      sub(/^  install:[ ]*/, "", install)
      gsub(/^"|"$/, "", install)
    }
    END { flush() }
  ' "$MANIFEST"
}

# Re-assert identity: a local override silently defeats the global setting and
# is the #1 way forks end up with the wrong author. Remove it, then verify the
# resolved identity; a mismatch after that means a wider-scope config (e.g. a
# stray ~/.gitconfig, which git reads after the nix-managed file) is winning,
# which this script must not edit - it fails the repo so the failure
# notification fires instead of the wrong identity passing silently.
assert_identity() {
  local r="$1"
  if git config --local user.email >/dev/null 2>&1; then
    log "[$r] removing local user.email override ($(git config --local user.email))"
    [ "$DRY" -eq 0 ] && git config --local --unset user.email
  fi
  if git config --local user.name >/dev/null 2>&1; then
    log "[$r] removing local user.name override"
    [ "$DRY" -eq 0 ] && git config --local --unset user.name
  fi
  case "$(git var GIT_AUTHOR_IDENT 2>/dev/null)" in
    "$IDENT_NAME <$IDENT_EMAIL>"*) : ;;
    *)
      log "[$r] ERROR: author identity does not resolve to $IDENT_EMAIL (check ~/.gitconfig)"
      return 1
      ;;
  esac
}

synced="" diverged="" skipped="" failed=""

log "===== sync-forks start (dry-run=$DRY, manifest=$MANIFEST) ====="

while IFS='|' read -r r branch install; do
  d="$GH_ROOT/$r"
  [ -d "$d/.git" ] || { log "[$r] not cloned, skip"; skipped="$skipped $r"; continue; }
  cd "$d" || { log "[$r] cd failed"; failed="$failed $r"; continue; }

  # In-progress rebase or merge: leave the repo alone entirely.
  gitdir=$(git rev-parse --git-dir 2>/dev/null || echo .git)
  if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ] || [ -f "$gitdir/MERGE_HEAD" ]; then
    log "[$r] rebase/merge in progress -> skipped"
    skipped="$skipped $r"
    continue
  fi

  if [ -n "$(git status --porcelain)" ]; then
    log "[$r] working tree dirty -> skipped"
    skipped="$skipped $r"
    continue
  fi

  head=$(git symbolic-ref --short HEAD 2>/dev/null || echo DETACHED)
  if [ "$head" != "$branch" ]; then
    log "[$r] on '$head', not default '$branch' -> skipped"
    skipped="$skipped $r"
    continue
  fi

  assert_identity "$r" || { failed="$failed $r"; continue; }

  git fetch --quiet --all --prune 2>>"$LOG" || { log "[$r] fetch failed"; failed="$failed $r"; continue; }

  # A manifest entry whose clone lacks the upstream remote (or names a branch
  # that does not exist there) must not read as "already up to date": with no
  # ref to compare against, both counts below would come back 0.
  if ! git rev-parse --verify --quiet "refs/remotes/upstream/$branch" >/dev/null; then
    log "[$r] no upstream/$branch after fetch (missing remote or wrong branch?) -> failed"
    failed="$failed $r"
    continue
  fi

  behind=$(git rev-list --count "$branch..upstream/$branch" 2>/dev/null || echo 0)
  ahead=$(git rev-list --count "upstream/$branch..$branch" 2>/dev/null || echo 0)

  if [ "$DRY" -eq 1 ]; then
    log "[$r] behind=$behind ahead=$ahead vs upstream/$branch"
    continue
  fi

  # Server-side sync only once the fork is known to have no local-only
  # commits: gh repo sync would still fast-forward the fork's remote branch
  # when local commits exist but are unpushed, leaving the next push rejected
  # as non-fast-forward. Non-fatal: local sync below is the layer that must
  # succeed. -b pins it to the manifest branch the rest of this loop uses.
  if [ "$ahead" -eq 0 ] && command -v gh >/dev/null 2>&1; then
    gh repo sync "shreejitverma/$r" -b "$branch" </dev/null >>"$LOG" 2>&1 \
      && log "[$r] server-side fork sync ok" \
      || log "[$r] server-side fork sync skipped (offline or API error)"
  fi

  repo_ok=1
  if [ "$behind" -gt 0 ]; then
    if [ "$ahead" -gt 0 ]; then
      log "[$r] DIVERGED: $ahead local, $behind upstream commit(s) -> left untouched, resolve manually"
      diverged="$diverged $r"
      continue
    fi
    if git merge --ff-only "upstream/$branch" >>"$LOG" 2>&1; then
      log "[$r] fast-forwarded $behind commit(s)"
      if [ -n "$install" ] && [ "$install" != "none" ]; then
        if ( cd "$d" && eval "$install" </dev/null >>"$LOG" 2>&1 ); then
          log "[$r] reinstalled ($install)"
        else
          log "[$r] reinstall FAILED ($install)"
          failed="$failed $r"
          repo_ok=0
        fi
      fi
    else
      log "[$r] ff-only merge unexpectedly failed -> left untouched"
      failed="$failed $r"
      continue
    fi
  else
    log "[$r] already up to date with upstream"
  fi

  if git push -q origin "$branch" 2>>"$LOG"; then
    [ "$repo_ok" -eq 1 ] && synced="$synced $r"
  else
    log "[$r] push to origin FAILED (auth/network?)"
    failed="$failed $r"
  fi
done < <(manifest_entries)

log "===== done. synced:[$synced ] diverged:[$diverged ] skipped:[$skipped ] failed:[$failed ] ====="

# Notify on failure only: diverged forks and hard failures need a human;
# a quiet success needs nothing.
if [ -n "$failed" ]; then
  notify "sync-forks: failures" "Failed:$failed"
elif [ -n "$diverged" ]; then
  notify "sync-forks: diverged forks" "Manual reconcile needed:$diverged"
fi
