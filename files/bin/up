#!/usr/bin/env bash
# up: update the whole machine in one command.
# Rebuilds nix-darwin, updates Homebrew, rustup, and the tldr cache.
set -euo pipefail

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

# Derived from this script's own location (files/bin/up), so `up` rebuilds
# whatever checkout it was invoked from instead of a hardcoded path.
FLAKE=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && cd ../.. && pwd)

bold "==> nix flake update"
nix flake update --flake "$FLAKE"

bold "==> darwin-rebuild switch"
/run/current-system/sw/bin/darwin-rebuild switch --flake "${FLAKE}#mac"

if have brew; then
  bold "==> brew update && upgrade && cleanup"
  brew update
  brew upgrade
  brew cleanup
fi

if have rustup; then
  bold "==> rustup update"
  rustup update
fi

if have tldr; then
  bold "==> tldr cache update"
  tldr --update >/dev/null 2>&1 || true
fi

bold "==> done. System is up to date."
